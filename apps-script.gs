const CLE_ADMIN = "CHANGEZ-MOI-mot-de-passe-admin";
function onglet(nom,entetes){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(nom);if(!s){s=ss.insertSheet(nom);s.appendRow(entetes)}return s}
const confirmations=()=>onglet("Confirmations",["Date","Nom","Téléphone","Table","Boissons"]);
const livreOr=()=>onglet("Livre d'or",["Date","Nom","Message"]);
const invites=()=>onglet("Invitations",["Date","ID","Nom","Civilité"]);
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){const d=JSON.parse(e.postData.contents||"{}");if(d.key!==CLE_ADMIN&&d.type==="invite")return json({error:"unauthorized"});if(d.type==="invite"){invites().appendRow([d.date,d.id,d.nom,d.civilite]);return json({ok:true})}if(d.type==="message")livreOr().appendRow([d.date,d.nom,d.message]);else confirmations().appendRow([d.date,d.nom,d.telephone,d.table,d.boissons]);return ContentService.createTextOutput("ok")}
function doGet(e){const p=e.parameter;if(p.action==="messages")return json(livreOr().getDataRange().getValues().slice(1).map(r=>({date:r[0],nom:r[1],message:r[2]})));if(p.action==="invite"){const rows=invites().getDataRange().getValues().slice(1),r=rows.find(x=>String(x[1])===String(p.id));return json(r?{id:r[1],nom:r[2],civilite:r[3]}:{error:"not_found"})}if(p.key!==CLE_ADMIN)return json({error:"unauthorized"});return json({rsvp:confirmations().getDataRange().getValues().slice(1).map(r=>({date:r[0],nom:r[1],telephone:r[2],table:r[3],boissons:r[4]})),invites:invites().getDataRange().getValues().slice(1).map(r=>({date:r[0],id:r[1],nom:r[2],civilite:r[3]}))})}
